[Unit]
Description=CareGrid Raspberry Pi Gateway
After=network-online.target mosquitto.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
Type=simple
User=hari
Group=hari
WorkingDirectory=/opt/caregrid/raspberry-pi
EnvironmentFile=/opt/caregrid/raspberry-pi/.env
ExecStart=/opt/caregrid/raspberry-pi/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
